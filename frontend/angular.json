{
    "$schema":  "./node_modules/@angular/cli/lib/config/schema.json",
    "version":  1,
    "newProjectRoot":  "projects",
    "projects":  {
                     "laliga-app":  {
                                        "projectType":  "application",
                                        "root":  "",
                                        "sourceRoot":  "src",
                                        "prefix":  "laliga",
                                        "architect":  {
                                                          "build":  {
                                                                        "builder":  "@angular-devkit/build-angular:application",
                                                                        "options":  {
                                                                                        "browser":  "src/main.ts",
                                                                                        "polyfills":  [
                                                                                                          "zone.js"
                                                                                                      ],
                                                                                        "tsConfig":  "tsconfig.app.json",
                                                                                        "inlineStyleLanguage":  "scss",
                                                                                        "assets":  [
                                                                                                       {
                                                                                                           "glob":  "**/*",
                                                                                                           "input":  "public",
                                                                                                           "output":  "/"
                                                                                                       },
                                                                                                       {
                                                                                                           "glob":  "**/*",
                                                                                                           "input":  "src/assets",
                                                                                                           "output":  "/assets"
                                                                                                       }
                                                                                                   ],
                                                                                        "styles":  [
                                                                                                       "src/styles.scss"
                                                                                                   ],
                                                                                        "outputPath":  "dist/laliga-app"
                                                                                    },
                                                                        "configurations":  {
                                                                                               "production":  {
                                                                                                                  "budgets":  [
                                                                                                                                  {
                                                                                                                                      "type":  "initial",
                                                                                                                                      "maximumWarning":  "800kB",
                                                                                                                                      "maximumError":  "1.5MB"
                                                                                                                                  }
                                                                                                                              ],
                                                                                                                  "optimization":  true,
                                                                                                                  "sourceMap":  false,
                                                                                                                  "extractLicenses":  true
                                                                                                              },
                                                                                               "development":  {
                                                                                                                   "optimization":  false,
                                                                                                                   "sourceMap":  true,
                                                                                                                   "extractLicenses":  false
                                                                                                               }
                                                                                           },
                                                                        "defaultConfiguration":  "production"
                                                                    },
                                                          "serve":  {
                                                                        "builder":  "@angular-devkit/build-angular:dev-server",
                                                                        "configurations":  {
                                                                                               "production":  {
                                                                                                                  "buildTarget":  "laliga-app:build:production"
                                                                                                              },
                                                                                               "development":  {
                                                                                                                   "buildTarget":  "laliga-app:build:development"
                                                                                                               }
                                                                                           },
                                                                        "defaultConfiguration":  "development"
                                                                    }
                                                      }
                                    }
                 }
}
