{
  "name": "LaLigaAIPredictor",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "es-ES",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "es-ES",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "expressions": [
      {
        "name": "pPostgresServer",
        "kind": "m",
        "expression": "\"localhost:5432\""
      },
      {
        "name": "pPostgresDatabase",
        "kind": "m",
        "expression": "\"laliga_predictor\""
      },
      {
        "name": "pApiBaseUrl",
        "kind": "m",
        "expression": "\"http://localhost:8000\""
      }
    ],
    "tables": [
      {
        "name": "Dim Equipo",
        "columns": [
          {
            "name": "Equipo ID",
            "dataType": "string",
            "sourceColumn": "team_id",
            "summarizeBy": "none"
          },
          {
            "name": "Equipo",
            "dataType": "string",
            "sourceColumn": "team",
            "summarizeBy": "none"
          },
          {
            "name": "Recién ascendido",
            "dataType": "boolean",
            "sourceColumn": "is_promoted",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim Equipo",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_dim_team\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim Jornada",
        "columns": [
          {
            "name": "Jornada",
            "dataType": "int64",
            "sourceColumn": "matchday",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Etiqueta jornada",
            "dataType": "string",
            "sourceColumn": "matchday_label",
            "summarizeBy": "none"
          },
          {
            "name": "Tramo temporada",
            "dataType": "string",
            "sourceColumn": "season_stage",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim Jornada",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_dim_matchday\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "Dim Posición",
        "columns": [
          {
            "name": "Posición",
            "dataType": "int64",
            "sourceColumn": "position",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Zona",
            "dataType": "string",
            "sourceColumn": "position_zone",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim Posición",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_dim_position\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "Partidos",
        "columns": [
          {
            "name": "Fixture ID",
            "dataType": "string",
            "sourceColumn": "fixture_id",
            "summarizeBy": "none"
          },
          {
            "name": "Temporada",
            "dataType": "string",
            "sourceColumn": "season",
            "summarizeBy": "none"
          },
          {
            "name": "Jornada",
            "dataType": "int64",
            "sourceColumn": "matchday",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Fecha referencia",
            "dataType": "dateTime",
            "sourceColumn": "reference_date",
            "summarizeBy": "none",
            "formatString": "Short Date"
          },
          {
            "name": "Fecha programada",
            "dataType": "dateTime",
            "sourceColumn": "scheduled_date",
            "summarizeBy": "none",
            "formatString": "General Date"
          },
          {
            "name": "Local ID",
            "dataType": "string",
            "sourceColumn": "home_team_id",
            "summarizeBy": "none"
          },
          {
            "name": "Local",
            "dataType": "string",
            "sourceColumn": "home_team",
            "summarizeBy": "none"
          },
          {
            "name": "Visitante ID",
            "dataType": "string",
            "sourceColumn": "away_team_id",
            "summarizeBy": "none"
          },
          {
            "name": "Visitante",
            "dataType": "string",
            "sourceColumn": "away_team",
            "summarizeBy": "none"
          },
          {
            "name": "Partido",
            "dataType": "string",
            "sourceColumn": "match_label",
            "summarizeBy": "none"
          },
          {
            "name": "Estado",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none"
          },
          {
            "name": "Jugado",
            "dataType": "boolean",
            "sourceColumn": "is_played",
            "summarizeBy": "none"
          },
          {
            "name": "Goles local",
            "dataType": "int64",
            "sourceColumn": "home_goals",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Goles visitante",
            "dataType": "int64",
            "sourceColumn": "away_goals",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Resultado real",
            "dataType": "string",
            "sourceColumn": "actual_result_label",
            "summarizeBy": "none"
          },
          {
            "name": "Modelo",
            "dataType": "string",
            "sourceColumn": "model",
            "summarizeBy": "none"
          },
          {
            "name": "Probabilidad local",
            "dataType": "double",
            "sourceColumn": "probability_home",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad empate",
            "dataType": "double",
            "sourceColumn": "probability_draw",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad visitante",
            "dataType": "double",
            "sourceColumn": "probability_away",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Pronóstico",
            "dataType": "string",
            "sourceColumn": "predicted_result_label",
            "summarizeBy": "none"
          },
          {
            "name": "Confianza",
            "dataType": "string",
            "sourceColumn": "confidence",
            "summarizeBy": "none"
          },
          {
            "name": "Goles esperados local",
            "dataType": "double",
            "sourceColumn": "expected_home_goals",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Goles esperados visitante",
            "dataType": "double",
            "sourceColumn": "expected_away_goals",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Marcador previsto",
            "dataType": "string",
            "sourceColumn": "predicted_score",
            "summarizeBy": "none"
          },
          {
            "name": "Cuotas disponibles",
            "dataType": "boolean",
            "sourceColumn": "market_odds_available",
            "summarizeBy": "none"
          },
          {
            "name": "Predicción correcta",
            "dataType": "boolean",
            "sourceColumn": "prediction_correct",
            "summarizeBy": "none"
          },
          {
            "name": "Update ID",
            "dataType": "string",
            "sourceColumn": "update_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partidos",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_fact_matches\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total partidos",
            "expression": "COUNTROWS('Partidos')",
            "formatString": "0",
            "displayFolder": "Operación"
          },
          {
            "name": "Partidos jugados",
            "expression": "CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Jugado] = TRUE())",
            "formatString": "0",
            "displayFolder": "Operación"
          },
          {
            "name": "Partidos pendientes",
            "expression": "[Total partidos] - [Partidos jugados]",
            "formatString": "0",
            "displayFolder": "Operación"
          },
          {
            "name": "Próxima jornada",
            "expression": "MINX(FILTER('Partidos', 'Partidos'[Jugado] = FALSE()), 'Partidos'[Jornada])",
            "formatString": "0",
            "displayFolder": "Operación"
          },
          {
            "name": "Precisión del pronóstico",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Predicción correcta] = TRUE()), [Partidos jugados])",
            "formatString": "0.0%",
            "displayFolder": "Calidad"
          },
          {
            "name": "Promedio de goles",
            "expression": "DIVIDE(SUM('Partidos'[Goles local]) + SUM('Partidos'[Goles visitante]), [Partidos jugados])",
            "formatString": "0.0",
            "displayFolder": "Resultados"
          },
          {
            "name": "Probabilidad Local",
            "expression": "AVERAGE('Partidos'[Probabilidad local])",
            "formatString": "0.0%",
            "displayFolder": "Predicción"
          },
          {
            "name": "Probabilidad Empate",
            "expression": "AVERAGE('Partidos'[Probabilidad empate])",
            "formatString": "0.0%",
            "displayFolder": "Predicción"
          },
          {
            "name": "Probabilidad Visitante",
            "expression": "AVERAGE('Partidos'[Probabilidad visitante])",
            "formatString": "0.0%",
            "displayFolder": "Predicción"
          },
          {
            "name": "Victorias locales esperadas",
            "expression": "SUM('Partidos'[Probabilidad local])",
            "formatString": "0.0",
            "displayFolder": "Predicción"
          },
          {
            "name": "Empates esperados",
            "expression": "SUM('Partidos'[Probabilidad empate])",
            "formatString": "0.0",
            "displayFolder": "Predicción"
          },
          {
            "name": "Victorias visitantes esperadas",
            "expression": "SUM('Partidos'[Probabilidad visitante])",
            "formatString": "0.0",
            "displayFolder": "Predicción"
          },
          {
            "name": "Partidos con mercado",
            "expression": "CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Cuotas disponibles] = TRUE())",
            "formatString": "0",
            "displayFolder": "Mercado"
          }
        ]
      },
      {
        "name": "Equipo-Partido",
        "columns": [
          {
            "name": "Fixture ID",
