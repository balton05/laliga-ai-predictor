            "sourceColumn": "remaining_matches",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Próxima jornada",
            "dataType": "int64",
            "sourceColumn": "next_matchday",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Predicciones mercado",
            "dataType": "int64",
            "sourceColumn": "market_predictions",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Predicciones deportivas",
            "dataType": "int64",
            "sourceColumn": "sports_predictions",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Simulaciones",
            "dataType": "int64",
            "sourceColumn": "simulations",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "Semilla",
            "dataType": "int64",
            "sourceColumn": "seed",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Calidad superada",
            "dataType": "boolean",
            "sourceColumn": "quality_passed",
            "summarizeBy": "none"
          },
          {
            "name": "Modo pipeline",
            "dataType": "string",
            "sourceColumn": "pipeline_mode",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Actualizaciones",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_update_status\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Última actualización",
            "expression": "CONCATENATEX(TOPN(1, 'Actualizaciones', 'Actualizaciones'[Creado UTC], DESC), 'Actualizaciones'[Update ID], \"\")",
            "displayFolder": "Auditoría"
          },
          {
            "name": "Calidad actual",
            "expression": "IF(MAX('Actualizaciones'[Calidad superada]), \"Correcta\", \"Revisar\")",
            "displayFolder": "Auditoría"
          },
          {
            "name": "Jornadas cerradas",
            "expression": "MAX('Actualizaciones'[Jornadas completadas])",
            "formatString": "0",
            "displayFolder": "Auditoría"
          },
          {
            "name": "Predicciones con mercado",
            "expression": "MAX('Actualizaciones'[Predicciones mercado])",
            "formatString": "0",
            "displayFolder": "Auditoría"
          }
        ]
      },
      {
        "name": "Estado API",
