            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "DG",
            "dataType": "int64",
            "sourceColumn": "goal_difference",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Puntos",
            "dataType": "int64",
            "sourceColumn": "points",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Posición actual",
            "dataType": "int64",
            "sourceColumn": "position",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "PPG",
            "dataType": "double",
            "sourceColumn": "ppg",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Update ID",
            "dataType": "string",
            "sourceColumn": "update_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Clasificación",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_current_standings\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Puntos actuales",
            "expression": "MAX('Clasificación'[Puntos])",
            "formatString": "0",
            "displayFolder": "Equipo"
          },
          {
            "name": "Posición actual equipo",
            "expression": "MIN('Clasificación'[Posición actual])",
            "formatString": "0",
            "displayFolder": "Equipo"
          }
        ]
      },
      {
        "name": "Simulación",
        "columns": [
          {
            "name": "Equipo ID",
            "dataType": "string",
            "sourceColumn": "team_id",
            "summarizeBy": "none"
          },
          {
            "name": "Equipo",
            "dataType": "string",
            "sourceColumn": "team",
            "summarizeBy": "none"
          },
          {
            "name": "Simulaciones",
            "dataType": "int64",
            "sourceColumn": "simulations",
            "summarizeBy": "none",
            "formatString": "#,0"
          },
          {
            "name": "Puntos esperados",
            "dataType": "double",
            "sourceColumn": "expected_points",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Mediana puntos",
            "dataType": "double",
            "sourceColumn": "median_points",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Puntos P05",
            "dataType": "double",
            "sourceColumn": "points_p05",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Puntos P95",
            "dataType": "double",
            "sourceColumn": "points_p95",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Posición esperada",
            "dataType": "double",
            "sourceColumn": "expected_position",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Mediana posición",
            "dataType": "double",
            "sourceColumn": "median_position",
            "summarizeBy": "none",
            "formatString": "0.0"
          },
          {
            "name": "Probabilidad campeón",
            "dataType": "double",
            "sourceColumn": "champion_probability",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad Top 4",
            "dataType": "double",
            "sourceColumn": "top4_probability",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad Top 6",
            "dataType": "double",
            "sourceColumn": "top6_probability",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad Europa",
            "dataType": "double",
            "sourceColumn": "europe_top7_probability",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad descenso",
            "dataType": "double",
            "sourceColumn": "relegation_probability",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Probabilidad último",
            "dataType": "double",
            "sourceColumn": "last_place_probability",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "Update ID",
            "dataType": "string",
            "sourceColumn": "update_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Simulación",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_simulation_summary\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Número de simulaciones",
            "expression": "MAX('Simulación'[Simulaciones])",
            "formatString": "#,0",
            "displayFolder": "Operación"
          },
          {
            "name": "Puntos esperados equipo",
            "expression": "MAX('Simulación'[Puntos esperados])",
            "formatString": "0.0",
            "displayFolder": "Equipo"
          },
          {
            "name": "Posición esperada equipo",
            "expression": "MIN('Simulación'[Posición esperada])",
            "formatString": "0.0",
            "displayFolder": "Equipo"
          },
          {
            "name": "P Campeón",
            "expression": "MAX('Simulación'[Probabilidad campeón])",
            "formatString": "0.0%",
            "displayFolder": "Zonas"
          },
          {
            "name": "P Top 4",
            "expression": "MAX('Simulación'[Probabilidad Top 4])",
            "formatString": "0.0%",
            "displayFolder": "Zonas"
          },
          {
            "name": "P Europa",
            "expression": "MAX('Simulación'[Probabilidad Europa])",
            "formatString": "0.0%",
            "displayFolder": "Zonas"
          },
          {
            "name": "P Descenso",
            "expression": "MAX('Simulación'[Probabilidad descenso])",
            "formatString": "0.0%",
            "displayFolder": "Zonas"
          },
          {
            "name": "Favorito al título",
            "expression": "CONCATENATEX(TOPN(1, ALL('Simulación'), 'Simulación'[Probabilidad campeón], DESC, 'Simulación'[Equipo], ASC), 'Simulación'[Equipo], \"\")",
            "displayFolder": "Resumen"
          },
          {
            "name": "Mayor riesgo de descenso",
            "expression": "CONCATENATEX(TOPN(1, ALL('Simulación'), 'Simulación'[Probabilidad descenso], DESC, 'Simulación'[Equipo], ASC), 'Simulación'[Equipo], \"\")",
            "displayFolder": "Resumen"
          }
        ]
      },
