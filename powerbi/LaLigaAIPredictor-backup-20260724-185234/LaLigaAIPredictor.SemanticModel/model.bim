        "measures": [
          {
            "name": "Estado de la API",
            "expression": "SELECTEDVALUE('Estado API'[Estado], \"Sin conexión\")",
            "displayFolder": "Sistema"
          }
        ],
        "partitions": [
          {
            "name": "Estado API",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Response = Json.Document(",
                "        Web.Contents(pApiBaseUrl, [RelativePath=\"health\"])",
                "    ),",
                "    Source = Table.FromRecords({Response})",
                "in",
                "    Source"
              ]
            }
          }
        ]
      }
