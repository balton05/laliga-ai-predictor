table Simulación
	lineageTag: 09785197-3a76-43d0-9bd0-47ba6b5a823b

	measure 'Número de simulaciones' = MAX('Simulación'[Simulaciones])
		formatString: #,0
		displayFolder: Operación
		lineageTag: 62133039-2233-4667-8b1c-45e4108468ed

	measure 'Puntos esperados equipo' = MAX('Simulación'[Puntos esperados])
		formatString: 0.0
		displayFolder: Equipo
		lineageTag: 4fb1e2ef-79b0-4bb4-bb7c-e5527b8d0691

	measure 'Posición esperada equipo' = MIN('Simulación'[Posición esperada])
		formatString: 0.0
		displayFolder: Equipo
		lineageTag: 4e1c6892-812e-4ec4-8d31-150a4f096641

	measure 'P Campeón' = MAX('Simulación'[Probabilidad campeón])
		formatString: 0.0%
		displayFolder: Zonas
		lineageTag: 33ab3ff3-6ee9-4c5f-b3bb-096b779e92d2

	measure 'P Top 4' = MAX('Simulación'[Probabilidad Top 4])
		formatString: 0.0%
		displayFolder: Zonas
		lineageTag: 2642bf0e-6ba7-4dce-8bd1-2da671d3613f

	measure 'P Europa' = MAX('Simulación'[Probabilidad Europa])
		formatString: 0.0%
		displayFolder: Zonas
		lineageTag: 2cdc31e0-056f-4c37-8fdc-73fa1d0be0d5

	measure 'P Descenso' = MAX('Simulación'[Probabilidad descenso])
		formatString: 0.0%
		displayFolder: Zonas
		lineageTag: 8b98c1dd-ed99-45b4-84fc-8946b6ee2535

	measure 'Favorito al título' = CONCATENATEX(TOPN(1, ALL('Simulación'), 'Simulación'[Probabilidad campeón], DESC, 'Simulación'[Equipo], ASC), 'Simulación'[Equipo], "")
		displayFolder: Resumen
		lineageTag: 8c61a44d-7ab1-40d5-a619-2291553ad254

	measure 'Mayor riesgo de descenso' = CONCATENATEX(TOPN(1, ALL('Simulación'), 'Simulación'[Probabilidad descenso], DESC, 'Simulación'[Equipo], ASC), 'Simulación'[Equipo], "")
		displayFolder: Resumen
		lineageTag: 3cdcabaf-f9c8-4fc6-9179-b5f5b24b5d9a

