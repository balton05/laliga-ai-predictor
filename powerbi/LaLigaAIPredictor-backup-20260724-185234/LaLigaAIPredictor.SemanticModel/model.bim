            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "GF",
            "dataType": "int64",
            "sourceColumn": "goals_for",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "GC",
