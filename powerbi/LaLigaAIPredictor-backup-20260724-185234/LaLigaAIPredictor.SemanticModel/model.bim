            "sourceColumn": "update_id",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Equipo-Partido",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(",
                "        pPostgresServer,",
                "        pPostgresDatabase,",
                "        [Query=\"SELECT * FROM bi_fact_team_matches\"]",
                "    )",
                "in",
                "    Source"
              ]
            }
          }
        ]
      },
      {
        "name": "Clasificación",
        "columns": [
          {
            "name": "Equipo ID",
            "dataType": "string",
            "sourceColumn": "team_id",
            "summarizeBy": "none"
          },
          {
            "name": "Equipo",
            "dataType": "string",
            "sourceColumn": "team",
            "summarizeBy": "none"
          },
          {
            "name": "PJ",
            "dataType": "int64",
            "sourceColumn": "played",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "PG",
