table Actualizaciones
	lineageTag: a8260384-3090-4400-b0a8-bbf47b822960

	measure 'Última actualización' = CONCATENATEX(TOPN(1, 'Actualizaciones', 'Actualizaciones'[Creado UTC], DESC), 'Actualizaciones'[Update ID], "")
		displayFolder: Auditoría
		lineageTag: 50a194a0-4c52-4017-adb3-acb5e527d9f7

	measure 'Calidad actual' =
			
			VAR UltimoRegistro =
			    TOPN(
			        1,
			        'Actualizaciones',
			        'Actualizaciones'[Creado UTC], DESC,
			        'Actualizaciones'[Update ID], DESC
			    )
			VAR Superada =
			    COUNTROWS(
			        FILTER(
			            UltimoRegistro,
			            'Actualizaciones'[Calidad superada] = TRUE()
			        )
			    ) > 0
			RETURN
			    IF(Superada, "Correcta", "Revisar")
		displayFolder: Auditoría
		lineageTag: ac16cf60-7c02-4aee-8411-977725890a57

	measure 'Jornadas cerradas' = MAX('Actualizaciones'[Jornadas completadas])
		formatString: 0
		displayFolder: Auditoría
		lineageTag: 000f05e3-9ba3-47ab-abdc-36c3248449b4

	measure 'Predicciones con mercado' = MAX('Actualizaciones'[Predicciones mercado])
		formatString: 0
		displayFolder: Auditoría
		lineageTag: a46d9a74-8710-4eba-98b3-1eedc5e52a42

