table Partidos
	lineageTag: 62ff5000-79bd-498b-8ab8-f427896f2511

	measure 'Total partidos' = COUNTROWS('Partidos')
		formatString: 0
		displayFolder: Operación
		lineageTag: a7ca0cee-8079-4fd2-8330-3fa64f48d66c

	measure 'Partidos jugados' = CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Jugado] = TRUE())
		formatString: 0
		displayFolder: Operación
		lineageTag: 4a4fc3d9-96bf-4d63-a8ab-24bc897db2aa

	measure 'Partidos pendientes' = [Total partidos] - [Partidos jugados]
		formatString: 0
		displayFolder: Operación
		lineageTag: 50d7cda3-93e8-441b-8ab1-5f3be39c57f8

	measure 'Próxima jornada' = MINX(FILTER('Partidos', 'Partidos'[Jugado] = FALSE()), 'Partidos'[Jornada])
		formatString: 0
		displayFolder: Operación
		lineageTag: 94dbd9d0-a2a6-4881-a955-061d2a5d0b2d

	measure 'Precisión del pronóstico' = DIVIDE(CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Predicción correcta] = TRUE()), [Partidos jugados])
		formatString: 0.0%
		displayFolder: Calidad
		lineageTag: 46d4c778-3f40-4a0d-afce-939f4016a7d6

	measure 'Promedio de goles' = DIVIDE(SUM('Partidos'[Goles local]) + SUM('Partidos'[Goles visitante]), [Partidos jugados])
		formatString: 0.0
		displayFolder: Resultados
		lineageTag: 1484623a-4c25-44c9-8744-b20261519782

	measure 'Probabilidad Local promedio' = AVERAGE('Partidos'[Probabilidad local])
		formatString: 0.0%
		displayFolder: Predicción
		lineageTag: 9ce632fa-805a-4632-9ce1-eb75b2d715dd

	measure 'Probabilidad Empate promedio' = AVERAGE('Partidos'[Probabilidad empate])
		formatString: 0.0%
		displayFolder: Predicción
		lineageTag: 333ae09a-c5f8-4672-9b01-93494b1d3ec2

	measure 'Probabilidad Visitante promedio' = AVERAGE('Partidos'[Probabilidad visitante])
		formatString: 0.0%
		displayFolder: Predicción
		lineageTag: 35b3e2da-2efb-44c7-b21e-8dd1d442645e

	measure 'Victorias locales esperadas' = SUM('Partidos'[Probabilidad local])
		formatString: 0.0
		displayFolder: Predicción
		lineageTag: 1ae9a231-b064-47c4-86cd-f22d26d08acc

	measure 'Empates esperados' = SUM('Partidos'[Probabilidad empate])
		formatString: 0.0
		displayFolder: Predicción
		lineageTag: fa7e8650-0ca4-4583-bc51-3329cdf7e315

	measure 'Victorias visitantes esperadas' = SUM('Partidos'[Probabilidad visitante])
		formatString: 0.0
		displayFolder: Predicción
		lineageTag: 34e723ac-6bc2-4ab0-ba5a-3b4fedf11c89

	measure 'Partidos con mercado' = CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Cuotas disponibles] = TRUE())
		formatString: 0
		displayFolder: Mercado
		lineageTag: 7be454c8-0d16-44db-987b-de10ed7ba0fc

