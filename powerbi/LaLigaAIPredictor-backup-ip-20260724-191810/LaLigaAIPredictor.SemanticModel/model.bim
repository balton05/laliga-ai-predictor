        "lineageTag": "62ff5000-79bd-498b-8ab8-f427896f2511",
        "measures": [
          {
            "name": "Total partidos",
            "displayFolder": "Operación",
            "expression": "COUNTROWS('Partidos')",
            "formatString": "0",
            "lineageTag": "a7ca0cee-8079-4fd2-8330-3fa64f48d66c"
          },
          {
            "name": "Partidos jugados",
            "displayFolder": "Operación",
            "expression": "CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Jugado] = TRUE())",
            "formatString": "0",
            "lineageTag": "4a4fc3d9-96bf-4d63-a8ab-24bc897db2aa"
          },
          {
            "name": "Partidos pendientes",
            "displayFolder": "Operación",
            "expression": "[Total partidos] - [Partidos jugados]",
            "formatString": "0",
            "lineageTag": "50d7cda3-93e8-441b-8ab1-5f3be39c57f8"
          },
          {
            "name": "Próxima jornada",
            "displayFolder": "Operación",
            "expression": "MINX(FILTER('Partidos', 'Partidos'[Jugado] = FALSE()), 'Partidos'[Jornada])",
            "formatString": "0",
            "lineageTag": "94dbd9d0-a2a6-4881-a955-061d2a5d0b2d"
          },
          {
            "name": "Precisión del pronóstico",
            "displayFolder": "Calidad",
            "expression": "DIVIDE(CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Predicción correcta] = TRUE()), [Partidos jugados])",
            "formatString": "0.0%",
            "lineageTag": "46d4c778-3f40-4a0d-afce-939f4016a7d6"
          },
          {
            "name": "Promedio de goles",
            "displayFolder": "Resultados",
            "expression": "DIVIDE(SUM('Partidos'[Goles local]) + SUM('Partidos'[Goles visitante]), [Partidos jugados])",
            "formatString": "0.0",
            "lineageTag": "1484623a-4c25-44c9-8744-b20261519782"
          },
          {
            "name": "Probabilidad Local promedio",
            "displayFolder": "Predicción",
            "expression": "AVERAGE('Partidos'[Probabilidad local])",
            "formatString": "0.0%",
            "lineageTag": "9ce632fa-805a-4632-9ce1-eb75b2d715dd"
          },
          {
            "name": "Probabilidad Empate promedio",
            "displayFolder": "Predicción",
            "expression": "AVERAGE('Partidos'[Probabilidad empate])",
            "formatString": "0.0%",
            "lineageTag": "333ae09a-c5f8-4672-9b01-93494b1d3ec2"
          },
          {
            "name": "Probabilidad Visitante promedio",
            "displayFolder": "Predicción",
            "expression": "AVERAGE('Partidos'[Probabilidad visitante])",
            "formatString": "0.0%",
            "lineageTag": "35b3e2da-2efb-44c7-b21e-8dd1d442645e"
          },
          {
            "name": "Victorias locales esperadas",
            "displayFolder": "Predicción",
            "expression": "SUM('Partidos'[Probabilidad local])",
            "formatString": "0.0",
            "lineageTag": "1ae9a231-b064-47c4-86cd-f22d26d08acc"
          },
          {
            "name": "Empates esperados",
            "displayFolder": "Predicción",
            "expression": "SUM('Partidos'[Probabilidad empate])",
            "formatString": "0.0",
            "lineageTag": "fa7e8650-0ca4-4583-bc51-3329cdf7e315"
          },
          {
            "name": "Victorias visitantes esperadas",
            "displayFolder": "Predicción",
            "expression": "SUM('Partidos'[Probabilidad visitante])",
            "formatString": "0.0",
            "lineageTag": "34e723ac-6bc2-4ab0-ba5a-3b4fedf11c89"
          },
          {
            "name": "Partidos con mercado",
            "displayFolder": "Mercado",
            "expression": "CALCULATE(COUNTROWS('Partidos'), 'Partidos'[Cuotas disponibles] = TRUE())",
            "formatString": "0",
            "lineageTag": "7be454c8-0d16-44db-987b-de10ed7ba0fc"
          }
        ],
